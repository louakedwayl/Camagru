{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "es2022",
    "outDir": "assets/js",
    "rootDir": "assets/ts",
    "strict": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["assets/ts/**/*.ts"]
}
